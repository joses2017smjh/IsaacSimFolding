Bootstrap: docker
From: ubuntu:22.04

# LeHome Challenge 2026 - Isaac Sim 5.1.0 / Isaac Lab 2.3.1 runtime base.
#
# Same shape as bhl-robustness-ladder/container/bhl.def and for the same reason:
# the OSU login node is too old (glibc 2.28) for Isaac Sim, so the image supplies
# glibc 2.35 and the GL/Vulkan userspace, the NVIDIA driver comes from the host
# via --nv, and NO Python package is baked in -- the venv lives on Lustre so the
# LeHome environment can be pip-installed editable and iterated on.
#
# The two additions over bhl.def are both LeHome dependencies:
#   open3d      needs libgl/libgomp at import time
#   pinocchio   needs a modern libstdc++, which 22.04 has
# ffmpeg stays for eval video capture (`--save_video`).

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq

    apt-get install -y --no-install-recommends \
        build-essential cmake git git-lfs curl wget ca-certificates \
        xz-utils unzip pkg-config \
        libatomic1 libgomp1 \
        libgl1 libglu1-mesa libegl1 libgles2 libglvnd0 libglx0 \
        libvulkan1 \
        libglib2.0-0 libsm6 libice6 libxext6 libxrender1 libx11-6 \
        libxrandr2 libxinerama1 libxcursor1 libxi6 libxt6 libxkbcommon0 \
        libxcb1 libxcb-glx0 libxcb-keysyms1 libxcb-image0 libxcb-shm0 \
        libxcb-icccm4 libxcb-sync1 libxcb-xfixes0 libxcb-shape0 \
        libxcb-randr0 libxcb-render-util0 libxcb-xinerama0 libxcb-xkb1 \
        libfontconfig1 libfreetype6 libjpeg8 libpng16-16 \
        libasound2 libnss3 libxcomposite1 libxdamage1 libxtst6 \
        ffmpeg \
        && rm -rf /var/lib/apt/lists/*

    git lfs install --system

    # uv: manages the Python 3.11 toolchain and resolves against lehome's uv.lock
    export UV_INSTALL_DIR=/opt/uv
    mkdir -p /opt/uv
    curl -LsSf https://astral.sh/uv/install.sh | sh
    # Symlink into a default PATH dir: %environment's PATH export is clobbered
    # by /etc/profile under a login shell, so don't depend on it.
    ln -sf /opt/uv/uv /usr/local/bin/uv
    ln -sf /opt/uv/uvx /usr/local/bin/uvx
    /usr/local/bin/uv --version

%environment
    export PATH=/opt/uv:$PATH
    export OMNI_KIT_ACCEPT_EULA=YES
    export ACCEPT_EULA=Y
    export __NV_PRIME_RENDER_OFFLOAD=1
    export MESA_LOADER_DRIVER_OVERRIDE=""

%labels
    Project    lehome-fold-repro
    IsaacSim   5.1.0
    IsaacLab   2.3.1
    LeRobot    0.4.3
    Python     3.11

%help
    Runtime base for the LeHome Challenge 2026 folding reproduction.
    Run with:  apptainer exec --nv --bind /nfs/hpc/share/$USER lehome.sif <cmd>
